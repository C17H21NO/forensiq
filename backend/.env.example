# =============================================================================
# ForensiQ - configuración de ejemplo
# =============================================================================

FORENSIQ_ENV=development

FORENSIQ_APP_NAME=ForensiQ Fingerprint API
FORENSIQ_APP_VERSION=0.2.0


# Exclusivamente para firmar tokens.
FORENSIQ_TOKEN_SIGNING_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET

# Solo necesario mientras existan hashes TP1 sin migrar.
# No utilizar como secreto para contraseñas nuevas.
FORENSIQ_LEGACY_PASSWORD_SECRET=forensiq-dev-secret-change-me

# Permite migración transparente de usuarios TP1.
FORENSIQ_ALLOW_LEGACY_PASSWORD_HASHES=true

# PBKDF2-HMAC-SHA256
FORENSIQ_PBKDF2_ITERATIONS=600000

# 8 horas
FORENSIQ_TOKEN_TTL_SECONDS=28800

# Solo para desarrollo local.
FORENSIQ_ENABLE_DEMO_USERS=true

FORENSIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Si se omite, utiliza backend/forensiq.sqlite3
# FORENSIQ_DATABASE_URL=sqlite:///...

# Si se omite, utiliza backend/app/uploads
# FORENSIQ_UPLOAD_DIR=...

FORENSIQ_MAX_UPLOAD_MB=20

FORENSIQ_LOG_LEVEL=INFO