# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

